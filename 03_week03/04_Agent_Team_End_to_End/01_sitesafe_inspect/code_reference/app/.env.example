# SiteSafe Inspect · web side (copy to .env and change every secret)
# docker compose up -d --build

# PostgreSQL: table owner (migrate / seed / test reset) and runtime login of web + dispatcher.
# WEB_DB_* are applied only when the db volume is created for the first time.
POSTGRES_PASSWORD=change-me-owner
WEB_DB_USER=sitesafe_app
WEB_DB_PASSWORD=change-me-runtime

WEB_PORT=3000

# AI side (DESIGN §5.1, §10): https only, the key is the same GATEWAY_API_KEY as ai/.env
AI_MODE=real
GATEWAY_URL=https://gpu-gateway.example:8443
GATEWAY_API_KEY=change-me-long-random-key
# PEM text or a path inside the container that verifies the gateway certificate
GATEWAY_CA_CERT=

STUCK_TIMEOUT_MIN=15

# Test helpers stay off in production
ENABLE_TEST_RESET=0
TEST_RESET_KEY=
BUG_MODE=0
