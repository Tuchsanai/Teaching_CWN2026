# SiteSafe Inspect · AI side (copy to ai/.env on the GPU machine)
# docker compose up -d --build

# Same value as GATEWAY_API_KEY of the web side (.env)
GATEWAY_API_KEY=change-me-long-random-key
GATEWAY_PORT=8000

RABBITMQ_USER=sitesafe
RABBITMQ_PASSWORD=change-me-mq

# DESIGN §6.3 / §6.2 · changing these later needs ppe.jobs deleted while empty
MAX_QUEUE_DEPTH=200
MAX_DELIVERY=3
PROCESSING_TIMEOUT_S=120

# Model (NFR-01): weights in MODEL_DIR, threshold chosen on the validation set (ai/train)
MODEL_DIR=./models
MODEL_FILE=best.pt
CONF_THRESHOLD=0.5
MODEL_VERSION=ppe-yolo-v1
# Reported by GET /v1/health (NFR-08); detected from nvidia-smi when empty
GPU_NAME=
