# ============================================================
# .env_example — ตัวอย่างไฟล์ .env ของบทนี้
# วิธีใช้: cp .env_example .env แล้วใส่ค่าจริงของตัวเอง
# ห้าม commit ไฟล์ .env (ถูก ignore ไว้แล้วใน .gitignore)
# ห้ามใส่เครื่องหมายคำพูดครอบค่า และห้ามเขียน comment ต่อท้ายบรรทัดค่า
# ============================================================

# API key ของ Vast.ai (สร้างที่ https://cloud.vast.ai/manage-keys/)
VAST_API_KEY=your_vast_api_key_here
