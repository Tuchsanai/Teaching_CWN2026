# ============================================================
# .env_example — ตัวอย่างไฟล์ .env
# วิธีใช้: cp .env_example .env แล้วใส่ค่าจริงของตัวเอง
# ห้าม commit ไฟล์ .env (ถูก ignore ไว้แล้วใน .gitignore)
# ============================================================


# vastai skill — credential เท่านั้น
# API key จาก https://cloud.vast.ai/manage-keys/ (แท็บ API Keys)
VAST_API_KEY=your_vast_api_key_here
# private key สำหรับ ssh/scp — path สัมพัทธ์ = อิงโฟลเดอร์ที่มี .env (ห้ามใส่ comment ท้ายบรรทัด เพราะ docker --env-file อ่านเป็นค่าด้วย)
VAST_SSH_KEY_FILE=Devtool_SSH/devtoolSSH
# timeout ต่อ 1 request ของ SDK (วินาที)
VAST_HTTP_TIMEOUT=20

# TypeSafe AI
TYPESAFE_API_KEY=apik_your_typesafe_api_key_here


# ===== Hugging Face =====
HF_TOKEN="hf_your_huggingface_token_here"


# ---- Git identity (ใช้กับ git config --global) ----
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"
