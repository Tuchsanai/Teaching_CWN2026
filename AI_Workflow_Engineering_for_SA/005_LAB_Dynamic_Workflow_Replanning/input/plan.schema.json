{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "แผนงาน AI สำหรับ LAB 005",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "trigger",
    "created_at",
    "tasks",
    "decisions",
    "reuse",
    "limits"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^plan-v(0|[1-9][0-9]*)$"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "kind",
          "inputs",
          "outputs",
          "depends_on",
          "status",
          "reason",
          "us_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "create",
              "revise",
              "verify",
              "cancel"
            ]
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "planned",
              "running",
              "done",
              "reused",
              "needs_recheck",
              "cancelled"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "us_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^US-(0[1-9]|1[0-9]|2[0-6])$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "decision",
          "authority",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "ai",
              "human-required",
              "human-confirmed"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "reuse": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact",
          "source_version",
          "disposition",
          "reason",
          "evidence"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "reuse",
              "recheck",
              "replace"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "blocking",
          "affected_tasks"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "affected_tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
