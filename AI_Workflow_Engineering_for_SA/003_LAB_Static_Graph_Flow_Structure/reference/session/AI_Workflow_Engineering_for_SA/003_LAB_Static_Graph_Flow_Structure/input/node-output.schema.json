{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lab003:node-output",
  "title": "LAB003 node envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "role",
    "sources",
    "flows",
    "assumptions",
    "conflicts_found"
  ],
  "properties": {
    "node_id": {
      "enum": [
        "customer",
        "kitchen-front",
        "manager",
        "state-machine",
        "structure",
        "merge"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flow_id",
          "title",
          "path_type",
          "actors",
          "us_refs",
          "fr_refs",
          "trigger",
          "preconditions",
          "steps",
          "postconditions",
          "completion_criteria",
          "evidence"
        ],
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path_type": {
            "enum": [
              "main",
              "alternative",
              "error"
            ]
          },
          "actors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "us_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^US-[0-9]{2}$"
            }
          },
          "fr_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^FR-[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "postconditions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completion_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fr_id",
                "source_path",
                "locator",
                "quote"
              ],
              "properties": {
                "fr_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "const": "input/fr-nfr-input.md"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "status",
          "impact"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ยังไม่ยืนยัน",
              "ยืนยันแล้ว"
            ]
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "conflicts_found": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic",
          "positions",
          "fr_refs",
          "evidence",
          "decision",
          "status",
          "affected_nodes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "positions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fr_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "resolved",
              "unresolved"
            ]
          },
          "affected_nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "ส่วนเพิ่มสำหรับ state-machine, structure, merge; ต้องตรวจตารางใน Markdown ประกอบ"
    }
  }
}
