{
  "name": "sabai-legacy-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "ชุดทดสอบ Playwright ของระบบจองคิว (ส่งมอบพร้อมระบบ)",
  "scripts": {
    "test": "playwright test",
    "test:p1": "playwright test --grep @P1",
