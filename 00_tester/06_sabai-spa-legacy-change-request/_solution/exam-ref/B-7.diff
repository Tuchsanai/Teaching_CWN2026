+import { createReview } from "@/lib/server/review.ts";
+import { handle, json, readJson } from "@/lib/server/http.ts";
+import { getSession } from "@/lib/session.ts";
+
+export const dynamic = "force-dynamic";
+
+/** POST /api/reviews {bookingId, stars, comment?} → 201 (EX-B7) */
+export async function POST(req: Request) {
+  return handle(async () => json(await createReview(await readJson(req), await getSession()), 201));
+}
