diff --git a/web/lib/server/review.ts b/web/lib/server/review.ts
new file mode 100644
index 0000000..5a149bf
--- /dev/null
+++ b/web/lib/server/review.ts
@@ -0,0 +1,30 @@
+// EX-B7 รีวิวนักบำบัดหลังใช้บริการเสร็จ 1–5 ดาว นัดละครั้ง
+import { withTx } from "../db.ts";
+import type { Session } from "../session.ts";
+import { ApiError } from "./http.ts";
+
+export async function createReview(body: Record<string, unknown>, session: Session | null) {
+  if (!session) throw new ApiError(401, "LOGIN_REQUIRED");
+  const stars = body.stars;
+  if (typeof stars !== "number" || !Number.isInteger(stars) || stars < 1 || stars > 5) throw new ApiError(422, "BAD_REQUEST", { field: "stars" });
+  const raw = String(body.bookingId ?? "").trim();
+  const id = Number(raw.replace(/^B/i, ""));
+  if (!raw || !Number.isInteger(id) || id <= 0) throw new ApiError(422, "BAD_REQUEST", { field: "bookingId" });
+  const comment = typeof body.comment === "string" ? body.comment.trim().slice(0, 500) || null : null;
+  return withTx(async (c) => {
+    const r = await c.query("SELECT id, code, customer_id, status FROM booking WHERE id = $1 FOR UPDATE", [id]);
+    const b = r.rows[0];
+    if (!b) throw new ApiError(404, "NOT_FOUND");
+    if (b.customer_id !== session.uid) throw new ApiError(403, "FORBIDDEN");
+    if (b.status !== "completed") throw new ApiError(422, "NOT_COMPLETED");
+    const t = await c.query("SELECT DISTINCT therapist_id FROM booking_slot WHERE booking_id = $1", [id]);
+    if (t.rows.length !== 1) throw new ApiError(422, "REVIEW_ONE_THERAPIST");
+    const dup = await c.query("SELECT 1 FROM review WHERE booking_id = $1", [id]);
+    if (dup.rows.length) throw new ApiError(409, "ALREADY_REVIEWED");
+    const ins = await c.query(
+      "INSERT INTO review (therapist_id, customer_id, booking_id, stars, comment) VALUES ($1, $2, $3, $4, $5) RETURNING id",
+      [t.rows[0].therapist_id, session.uid, id, stars, comment],
+    );
+    return { ok: true, reviewId: ins.rows[0].id, bookingCode: b.code, stars };
+  });
+}
