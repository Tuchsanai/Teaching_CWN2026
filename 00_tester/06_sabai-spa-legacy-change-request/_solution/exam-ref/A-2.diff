+// EX2 (ชุด A) golden master ของ POST /api/price
+//   node tests/exam2/run.mjs            ตรวจกับ golden (exit 0 = ตรงทั้งหมด)
+//   node tests/exam2/run.mjs --record   บันทึก golden ใหม่จากระบบที่รันอยู่ (ใช้กับระบบตั้งต้นเท่านั้น)
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+
+const BASE = (process.env.BASE_URL || "http://localhost:4000").replace(/\/$/, "");
+const GOLDEN = join(dirname(fileURLToPath(import.meta.url)), "golden");
+const RECORD = process.argv.includes("--record");
+const NOW = "2026-10-10T10:00:00+07:00";
+const USERS = {
+  U01: ["nida@sabai.test", "Nida@2026"], U02: ["ton@sabai.test", "Ton@2026"], U04: ["fon@sabai.test", "Fon@2026"],
+  U05: ["prae@sabai.test", "Prae@2026"], U06: ["vipa@sabai.test", "Vipa@2026"], U08: ["liwei@sabai.test", "LiWei@2026"],
+};
+
+async function call(method, path, body, cookie) {
+  const headers = { "Content-Type": "application/json", "Accept-Language": "th" };
+  if (cookie) headers.Cookie = cookie;
+  const r = await fetch(BASE + path, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
+  const set = r.headers.get("set-cookie");
+  const text = await r.text();
+  let json; try { json = JSON.parse(text); } catch { json = { raw: text }; }
+  return { status: r.status, json, set };
+}
+async function login(u) {
+  const r = await call("POST", "/api/auth/login", { email: USERS[u][0], password: USERS[u][1] });
+  return r.set.match(/sabai_session=[^;]*/)[0];
+}
+
+const d = { date: "2026-10-20", time: "10:00" };
+const g = (n, extra = {}) => ({ type: "group", serviceCode: "S01", people: n, date: "2026-10-16", time: "10:00", ...extra });
+const CASES = {
+  "guest-s01": [null, { type: "single", serviceCode: "S01", ...d }],
+  "u01-s04-gold": ["U01", { type: "single", serviceCode: "S04", ...d }],
+  "u01-s05-gold": ["U01", { type: "single", serviceCode: "S05", ...d }],
+  "u06-s05-plat-redeem1": ["U06", { type: "single", serviceCode: "S05", ...d, redeemBlocks: 1 }],
+  "u05-s01-gold-redeem1": ["U05", { type: "single", serviceCode: "S01", ...d, redeemBlocks: 1 }],
+  "u04-s05-redeem2": ["U04", { type: "single", serviceCode: "S05", ...d, redeemBlocks: 2 }],
+  "u02-s01-birthday": ["U02", { type: "single", serviceCode: "S01", ...d, useBirthday: true }],
+  "group3": ["U08", g(3)],
+  "group4": ["U08", g(4)],
+  "group5": ["U08", g(5)],
+  "group4-u01-gold": ["U01", g(4)],
+  "group4-u04-redeem2-h04": ["U04", g(4, { redeemBlocks: 2, hotelCode: "H04" })],
+  "group4-u04-redeem2-h04-gc01": ["U04", g(4, { redeemBlocks: 2, hotelCode: "H04", giftCardCode: "SABAI-GC-2000" })],
+  "group5-h04": ["U08", g(5, { hotelCode: "H04" })],
+  "group6-h04": ["U08", g(6, { hotelCode: "H04" })],
+  "s01-h01-2.0": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H01" }],
+  "s01-h02-5.0": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H02" }],
+  "s01-h03-5.1": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H03" }],
+  "s01-h04-12": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H04" }],
+  "s01-h05-15": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H05" }],
+  "s01-dist-15.0": [null, { type: "single", serviceCode: "S01", ...d, distanceKm: 15.0 }],
+  "s01-h06-15.1": [null, { type: "single", serviceCode: "S01", ...d, hotelCode: "H06" }],
+  "p01-2-h04": ["U08", { type: "package", serviceCode: "P01", people: 2, date: "2026-10-16", time: "10:00", hotelCode: "H04" }],
+  "p01-4": ["U08", { type: "package", serviceCode: "P01", people: 4, date: "2026-10-16", time: "10:00" }],
+  "u04-s06-gc01": ["U04", { type: "single", serviceCode: "S06", ...d, giftCardCode: "SABAI-GC-2000" }],
+  "u04-s04-gc01": ["U04", { type: "single", serviceCode: "S04", ...d, giftCardCode: "SABAI-GC-2000" }],
+  "u02-s01-gc03-last": ["U02", { type: "single", serviceCode: "S01", ...d, giftCardCode: "SABAI-GC-LAST" }],
+  "u02-s01-gc04-exp": ["U02", { type: "single", serviceCode: "S01", ...d, giftCardCode: "SABAI-GC-EXP" }],
+  "u04-s01-gc05-zero": ["U04", { type: "single", serviceCode: "S01", ...d, giftCardCode: "SABAI-GC-ZERO" }],
+};
+
+let fails = 0;
+mkdirSync(GOLDEN, { recursive: true });
+for (const [name, [user, body]] of Object.entries(CASES)) {
+  const rs = await call("POST", "/api/test/reset", { now: NOW });
+  if (rs.status !== 200) { console.error("reset failed", rs.status); process.exit(2); }
+  const cookie = user ? await login(user) : undefined;
+  const r = await call("POST", "/api/price", body, cookie);
+  const actual = { status: r.status, body: r.json };
+  const file = join(GOLDEN, `${name}.json`);
+  if (RECORD) { writeFileSync(file, JSON.stringify(actual, null, 2) + "\n"); console.log("recorded", name); continue; }
+  const expected = JSON.parse(readFileSync(file, "utf8"));
+  if (JSON.stringify(expected) === JSON.stringify(actual)) console.log("ok  ", name);
+  else { fails++; console.log("DIFF", name, "\n  expected", JSON.stringify(expected.body).slice(0, 300), "\n  actual  ", JSON.stringify(actual.body).slice(0, 300)); }
+}
+await call("POST", "/api/test/reset", { now: NOW });
+console.log(RECORD ? "recorded" : `${Object.keys(CASES).length - fails}/${Object.keys(CASES).length} match`);
+process.exit(fails ? 1 : 0);
