+import { query } from "@/lib/db.ts";
+import { ApiError, handle, json, readJson } from "@/lib/server/http.ts";
+import { getSession } from "@/lib/session.ts";
+
+export const dynamic = "force-dynamic";
+
+/** POST /api/admin/services/:code {active: true|false} — เจ้าของร้านเปิด/ปิดบริการ (EX-A6) */
+export async function POST(req: Request, ctx: { params: Promise<{ code: string }> }) {
+  return handle(async () => {
+    const s = await getSession();
+    if (!s) throw new ApiError(401, "LOGIN_REQUIRED");
+    if (s.role !== "owner") throw new ApiError(403, "FORBIDDEN");
+    const { code } = await ctx.params;
+    const body = await readJson(req);
+    if (typeof body.active !== "boolean") throw new ApiError(422, "BAD_REQUEST", { field: "active" });
+    const r = await query("UPDATE service SET active = $1 WHERE code = $2 RETURNING code, active", [body.active, String(code).toUpperCase()]);
+    if (!r.rows[0]) throw new ApiError(404, "NOT_FOUND");
+    return json(r.rows[0]);
+  });
+}
