+-- EX-A6 · ปิดบริการชั่วคราว (S03 ประคบสมุนไพร) · รันซ้ำได้ (idempotent)
+BEGIN;
+ALTER TABLE service ADD COLUMN IF NOT EXISTS active BOOLEAN NOT NULL DEFAULT TRUE;
+UPDATE service SET active = FALSE WHERE code = 'S03' AND active;
+COMMIT;
