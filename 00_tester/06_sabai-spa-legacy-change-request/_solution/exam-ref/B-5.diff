-import { json } from "@/lib/server/http.ts";
+import { ApiError, handle, json, readJson } from "@/lib/server/http.ts";
+import { parseClockValue } from "@/lib/clock.ts";
+import { query } from "@/lib/db.ts";
 
 export const dynamic = "force-dynamic";
 
@@ -11,3 +13,16 @@ export async function GET() {
   const { now, today } = await clock();
   return json({ now: bangkokIso(now), today });
 }
+
+/** POST /api/test/today {now} — EX-B5 test seam: เลื่อนนาฬิการะบบโดยไม่ reset ข้อมูล (โหมดทดสอบเท่านั้น) */
+export async function POST(req: Request) {
+  if (!config.allowTestReset) return new Response("Not Found", { status: 404 });
+  return handle(async () => {
+    const body = await readJson(req);
+    const at = typeof body.now === "string" ? parseClockValue(body.now) : null;
+    if (!at) throw new ApiError(422, "BAD_REQUEST", { field: "now" });
+    await query("UPDATE app_setting SET value = $1 WHERE key = 'test_today'", [bangkokIso(at)]);
+    const { now, today } = await clock();
+    return json({ ok: true, now: bangkokIso(now), today });
+  });
+}
