+// EX5-red (ชุด B): ทำซ้ำเรื่องร้องเรียน — กดเสร็จนัดสัปดาห์หน้า (B02 17 ต.ค.) ตอน "วันนี้" ของ seed ต้องไม่ได้
+const BASE = (process.env.BASE_URL || "http://localhost:4000").replace(/\/$/, "");
+const post = (p, b, ck) => fetch(BASE + p, { method: "POST", headers: { "Content-Type": "application/json", ...(ck ? { Cookie: ck } : {}) }, body: JSON.stringify(b ?? {}) });
+await post("/api/test/reset", {});
+const lr = await post("/api/auth/login", { email: "owner@sabai.test", password: "Owner@2026" });
+const ck = lr.headers.get("set-cookie").match(/sabai_session=[^;]*/)[0];
+const r = await post("/api/admin/bookings/2/complete", {}, ck);
+const j = await r.json();
+await post("/api/test/reset", {});
+const ok = r.status === 422 && j.error === "NOT_STARTED";
+console.log(ok ? "PASS" : `FAIL: complete B02 → ${r.status} ${j.error ?? ""}`);
+process.exit(ok ? 0 : 1);
