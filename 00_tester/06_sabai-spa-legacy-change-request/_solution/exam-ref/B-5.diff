--- /dev/null
+++ b/web/lib/rules/complete.ts
@@ -0,0 +1,7 @@
+// EX-B5 กด "ใช้บริการเสร็จ" ได้เมื่อเวลาปัจจุบันของระบบ ≥ เวลาเริ่มนัด + COMPLETE_AFTER_MIN นาที
+
+export const COMPLETE_AFTER_MIN = 60;
+
+export function canComplete(nowMs: number, startMs: number): boolean {
+  return nowMs >= startMs + COMPLETE_AFTER_MIN * 60_000;
+}
