diff --git a/tests/exam2/run.mjs b/tests/exam2/run.mjs
new file mode 100644
index 0000000..3f4b9b9
--- /dev/null
+++ b/tests/exam2/run.mjs
@@ -0,0 +1,67 @@
+// EX2 (ชุด B) golden master: GET /api/slots ทุกบริการ · ยกเลิกนัดขอบ 24 ชม. · สถานะบัตรของขวัญขอบวันหมดอายุ
+//   node tests/exam2/run.mjs            ตรวจกับ golden (exit 0 = ตรงทั้งหมด)
+//   node tests/exam2/run.mjs --record   บันทึก golden ใหม่ (รันกับระบบตั้งต้นเท่านั้น)
+import { readFileSync, writeFileSync, mkdirSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+
+const BASE = (process.env.BASE_URL || "http://localhost:4000").replace(/\/$/, "");
+const GOLDEN = join(dirname(fileURLToPath(import.meta.url)), "golden");
+const RECORD = process.argv.includes("--record");
+const NOW = "2026-10-10T10:00:00+07:00";
+
+async function call(method, path, body, cookie) {
+  const headers = { "Content-Type": "application/json", "Accept-Language": "th" };
+  if (cookie) headers.Cookie = cookie;
+  const r = await fetch(BASE + path, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
+  const set = r.headers.get("set-cookie");
+  const text = await r.text();
+  let json; try { json = JSON.parse(text); } catch { json = { raw: text }; }
+  return { status: r.status, json, set };
+}
+const reset = async (now = NOW) => { const r = await call("POST", "/api/test/reset", { now }); if (r.status !== 200) { console.error("reset failed"); process.exit(2); } };
+const login = async (email, password) => (await call("POST", "/api/auth/login", { email, password })).set.match(/sabai_session=[^;]*/)[0];
+
+const SERVICES = [["S01", "single"], ["S02", "single"], ["S03", "single"], ["S04", "single"], ["S05", "single"], ["S06", "single"], ["S07", "single"], ["P01", "package"]];
+const DATES = ["2026-10-10", "2026-10-11", "2026-10-12", "2026-11-09", "2026-11-10"];
+const slim = (r) => ({ status: r.status, error: r.json.error ?? null, min: r.json.min ?? null, max: r.json.max ?? null,
+  slots: (r.json.slots ?? []).map((s) => `${s.time}-${s.endTime}:${s.available ? 1 : 0}:${s.therapists.map((t) => t.code).join("")}`) });
+
+const CASES = {};
+for (const [svc, type] of SERVICES) for (const date of DATES) CASES[`slots-${svc}-${date}`] = async () => { await reset(); return slim(await call("GET", `/api/slots?service=${svc}&date=${date}&type=${type}&people=1`)); };
+CASES["slots-couple-S02-2026-10-17"] = async () => { await reset(); return slim(await call("GET", "/api/slots?service=S02&date=2026-10-17&type=couple&people=2")); };
+for (const [label, now] of [["0959", "2026-10-10T09:59:00+07:00"], ["1000", "2026-10-10T10:00:00+07:00"], ["1001", "2026-10-10T10:01:00+07:00"]]) {
+  CASES[`cancel-B05-at-${label}`] = async () => {
+    await reset(now);
+    const ck = await login("nida@sabai.test", "Nida@2026");
+    const list = await call("GET", "/api/me/bookings", undefined, ck);
+    const can = list.json.bookings.find((b) => b.code === "B05")?.canCancel ?? null;
+    const r = await call("POST", "/api/bookings/5/cancel", {}, ck);
+    return { canCancel: can, status: r.status, error: r.json.error ?? null };
+  };
+}
+for (const [label, now] of [["1009", "2026-10-09T10:00:00+07:00"], ["1010", NOW], ["1011", "2026-10-11T10:00:00+07:00"]]) {
+  CASES[`giftcards-at-${label}`] = async () => {
+    await reset(now);
+    const out = {};
