{
  "browser": {
    "mode": "launch",
    "executable_path": "/ms-playwright/chromium-1243/chrome-linux64/chrome"
  },
  "start_url": { "url": "http://petshop:3000/" },
  "environment": { "locale": "th-TH", "timezone": "Asia/Bangkok" },
  "actions": [
    { "step_id": "home-ready", "action": "wait_for", "locator": { "kind": "test_id", "value": "hero" }, "state": "visible", "timeout_ms": 15000 },
    { "step_id": "search-fill", "action": "fill", "locator": { "kind": "test_id", "value": "search-input" }, "value": { "source": "literal", "value": "แซลมอน" }, "timeout_ms": 10000 },
    { "step_id": "search-submit", "action": "click", "locator": { "kind": "test_id", "value": "search-submit" }, "timeout_ms": 10000 },
    { "step_id": "results-ready", "action": "wait_for", "locator": { "kind": "test_id", "value": "result-count" }, "state": "visible", "timeout_ms": 15000 },
    { "step_id": "open-product", "action": "click", "locator": { "kind": "css", "selector": "[data-testid=product-card][data-slug=lickable-salmon-treat] [data-testid=product-name]" }, "timeout_ms": 10000 },
    { "step_id": "add-to-cart", "action": "click", "locator": { "kind": "test_id", "value": "add-to-cart" }, "timeout_ms": 15000 },
    { "step_id": "open-cart", "action": "click", "locator": { "kind": "test_id", "value": "cart-link" }, "timeout_ms": 10000 },
    { "step_id": "coupon-fill", "action": "fill", "locator": { "kind": "test_id", "value": "coupon-input" }, "value": { "source": "literal", "value": "PAW10" }, "timeout_ms": 15000 },
    { "step_id": "coupon-apply", "action": "click", "locator": { "kind": "test_id", "value": "coupon-apply" }, "timeout_ms": 10000 },
    { "step_id": "coupon-message", "action": "wait_for", "locator": { "kind": "test_id", "value": "coupon-message" }, "state": "visible", "timeout_ms": 15000 }
  ],
  "capture": {
    "at_end": ["dom", "accessibility", "screenshot", "url", "storage"],
    "events": ["console", "page-errors", "network"],
    "network": { "request_body": true, "response_body": true, "header_values": false }
  }
}
