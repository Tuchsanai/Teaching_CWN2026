# คัดลอกเป็น .env ก่อนใช้งาน:  cp .env.example .env

# ---- PostgreSQL (ใช้ภายใน docker เท่านั้น) ----
POSTGRES_USER=massage
POSTGRES_PASSWORD=massage_pw
POSTGRES_DB=massage_shop

# ---- LLM (OpenAI-compatible) ----
# ค่าเริ่มต้น: mock LLM (รันด้วย docker compose --profile mock up -d --build)
LLM_BASE_URL=http://mock-llm:8000
LLM_MODEL=mock-thai-massage
# ใส่เฉพาะเมื่อ server ต้องการ key (ห้าม commit key จริง!)
LLM_API_KEY=

# ---- ตัวอย่างเมื่อใช้ ninfer บน Vast.ai จริง ----
# LLM_BASE_URL=http://<VAST_IP>:<VAST_PORT>      (ไม่ต้องมี /v1 ต่อท้าย)
# LLM_MODEL=<ชื่อโมเดลที่ server รายงานใน /v1/models>
# LLM_API_KEY=<ถ้ามี>
LLM_TIMEOUT_MS=120000
