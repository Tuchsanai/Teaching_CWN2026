# คัดลอกเป็น .env (ค่าสำหรับ docker compose) · .env.vast (LLM · GPU-1) · .env.aibox (ai-box · GPU-2/3) · ห้าม commit ไฟล์ .env*
# ไม่มีไฟล์ใดเลย + --profile mock = โหมดฟรีครบระบบ (LLM/STT/TTS/rerank = mock-llm)

# ---------------- .env.vast (ให้ chat-worker) ----------------
# โหมดแชทบอท: ai = เรียก LLM จริงตาม LLM_* · mock = ใช้ mock-llm (ต้องเปิด --profile mock)
# ถ้าไม่ตั้ง MODE และไม่มี LLM_BASE_URL ระบบจะใช้ mock ให้อัตโนมัติ
MODE=mock
# LLM แบบ OpenAI-compatible (Qwen บน Vast.ai ผ่าน NInfer) · ใส่หรือไม่ใส่ /v1 ท้าย URL ก็ได้
LLM_BASE_URL=http://<vast-ip>:<port>/v1
LLM_MODEL=<ชื่อโมเดล Qwen จาก neroued>
LLM_API_KEY=<api-key-ของ-ninfer>

# ---------------- .env.aibox (ให้ chat-worker / stt-worker / tts-worker · 4 บรรทัด ไม่มี quote) ----------------
# ai-box: GPU-2 = Whisper (stt) · GPU-3 = VoxCPM2 (tts) + bge-reranker (rerank) · เครื่องเดียวก็ได้ (ใส่ URL เดียวกัน)
# ไม่มีไฟล์ → http://mock-llm:8000 ทั้งหมด (mock STT เทียบ sha256 ไฟล์ทดสอบ · mock TTS เล่นเสียง VoxCPM2 ที่อัดไว้ · rerank = ลำดับเดิม)
STT_URL=http://<vast-ip-gpu2>:<port>
TTS_URL=http://<vast-ip-gpu3>:<port>
RERANK_URL=http://<vast-ip-gpu3>:<port>
AIBOX_API_KEY=<api-key-ของ-ai-box>

# ---------------- .env (ค่าของ docker compose · ไม่บังคับ) ----------------
# รหัสผ่านหลังร้าน /admin (ค่า dev)
ADMIN_PASSWORD=admin1234
# token ให้สคริปต์ส่งผลประเมิน/โหลดเทสต์เข้า /api/admin/eval · /api/admin/load (header x-eval-token)
EVAL_TOKEN=bm-eval
# reranker: on (ค่าเริ่มต้น · hybrid top 20 → rerank → top 4) | off (hybrid top 4)
RERANK=on
# prefetch ต่อคิว (จำนวนงานพร้อมกันต่อ 1 worker) · ขยาย worker: --scale chat-worker=2
CHAT_PREFETCH=4
STT_PREFETCH=4
TTS_PREFETCH=2
# mock-llm หน่วงเวลาให้ใกล้ของจริง (load test โหมดฟรี): ms ต่อ delta · ก่อน token แรก · STT · TTS · rerank · จำนวนแชทพร้อมกัน (0 = ไม่จำกัด)
MOCK_DELAY_MS=15
MOCK_TTFT_MS=0
MOCK_STT_MS=0
MOCK_TTS_MS=0
MOCK_RERANK_MS=0
MOCK_LLM_SLOTS=0

# ค่าใน network ของ compose (ตั้งให้แล้วใน docker-compose.yml · ใช้เมื่อรันนอก docker)
DATABASE_URL=postgres://bm:bm@db:5432/buildmart
AMQP_URL=amqp://guest:guest@rabbitmq:5672
