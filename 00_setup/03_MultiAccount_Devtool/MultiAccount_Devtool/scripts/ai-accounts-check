#!/bin/bash
# ai-accounts-check — ตรวจระบบหลายบัญชีแบบไม่ต้องล็อกอิน แล้วพิมพ์ตาราง PASS/FAIL/SKIP
#   ai-accounts-check                      # ตรวจทั้งหมด (รวมเปิด Playwright MCP ผ่าน stdio จริง)
#   AI_CHECK_URL=https://... ai-accounts-check   # เปลี่ยนเว็บที่ใช้ทดสอบ browser_navigate
#   ai-accounts-check --no-browser         # ข้ามการเปิดเบราว์เซอร์ (SKIP)
# ไม่อ่าน/ไม่พิมพ์ credential; รหัส shared-check แสดงเป็น sha256 ย่อเท่านั้น
set -u
. /etc/ai-accounts/ai-accounts.conf
export PLAYWRIGHT_BROWSERS_PATH
URL="${AI_CHECK_URL:-https://example.com/}"
NO_BROWSER=0; [ "${1:-}" = "--no-browser" ] && NO_BROWSER=1

ROWS=(); NP=0; NF=0; NS=0
rec() {  # status item evidence
    ROWS+=("$1|$2|$3")
    case "$1" in PASS) NP=$((NP+1));; FAIL) NF=$((NF+1));; SKIP) NS=$((NS+1));; esac
}
ok() { if "$@" >/dev/null 2>&1; then return 0; else return 1; fi; }

C="$BASE_PATH/.Claude"; X="$BASE_PATH/.Codex"
echo "ai-accounts-check — BASE_PATH=$BASE_PATH  (กำลังตรวจ... อาจใช้เวลา 1–2 นาที)" >&2

# 1) CLI ใน image
for c in claude codex playwright-mcp; do
    if v="$($c --version 2>/dev/null | head -n1)" && [ -n "$v" ]; then rec PASS "$c ติดตั้งใน image" "$(command -v $c): $v"
    else rec FAIL "$c ติดตั้งใน image" "ไม่พบใน PATH หรือ --version ล้มเหลว"; fi
done

# 2) 10 wrapper --version
for a in $CLAUDE_ACCOUNTS $CODEX_ACCOUNTS; do
    if v="$($a --version 2>&1 | head -n1)" && [ -n "$v" ] && [[ "$v" != *"ไม่พบ"* ]]; then rec PASS "$a --version" "$(readlink -f "$(command -v $a)") → $v"
    else rec FAIL "$a --version" "${v:-no output}"; fi
done

# 3) config root คนละโฟลเดอร์
roots="$(find "$C" "$X" -mindepth 1 -maxdepth 1 -type d -name '*yolo[0-9]*' 2>/dev/null | xargs -r -n1 readlink -f | sort)"
n="$(printf '%s\n' "$roots" | grep -c .)"; u="$(printf '%s\n' "$roots" | sort -u | grep -c .)"
if [ "$n" -ge 10 ] && [ "$n" = "$u" ]; then rec PASS "config root แยกกัน 10 โฟลเดอร์" "find: $n โฟลเดอร์ ไม่ซ้ำ $u (.Claude/yolo1..5, .Codex/cyolo1..5)"
else rec FAIL "config root แยกกัน 10 โฟลเดอร์" "find: $n โฟลเดอร์ ไม่ซ้ำ $u"; fi
dr="$(AI_ACCOUNTS_DRY_RUN=1 yolo1 2>&1; AI_ACCOUNTS_DRY_RUN=1 cyolo1 2>&1)"
if grep -q "CLAUDE_CONFIG_DIR=$C/yolo1" <<<"$dr" && grep -q "CODEX_HOME=$X/cyolo1" <<<"$dr"; then rec PASS "wrapper ตั้ง CLAUDE_CONFIG_DIR / CODEX_HOME" "dry-run yolo1 → $C/yolo1, cyolo1 → $X/cyolo1 (HOME=$HOME ไม่เปลี่ยน)"
else rec FAIL "wrapper ตั้ง CLAUDE_CONFIG_DIR / CODEX_HOME" "dry-run ไม่พบ env ที่คาด"; fi

# 4) skill shared-check ทุกบัญชีชี้ไฟล์เดียวกัน
skill_check() {  # label dir accounts...
    local label="$1" base="$2"; shift 2
    local want; want="$(readlink -f "$base/shared/skills/shared-check/SKILL.md" 2>/dev/null)"
    local bad="" a got
    for a in "$@"; do
        got="$(readlink -f "$base/$a/skills/shared-check/SKILL.md" 2>/dev/null)"
        [ -n "$want" ] && [ "$got" = "$want" ] || bad="$bad $a"
    done
    if [ -n "$want" ] && [ -z "$bad" ]; then rec PASS "$label skill shared-check → ไฟล์เดียวกัน" "readlink -f ทุกบัญชี = $want"
    else rec FAIL "$label skill shared-check → ไฟล์เดียวกัน" "ไม่ตรง:${bad:- ไม่พบไฟล์ใน shared}"; fi
}
skill_check Claude "$C" $CLAUDE_ACCOUNTS
skill_check Codex "$X" $CODEX_ACCOUNTS
bad=""; for a in $CLAUDE_ACCOUNTS; do [ "$(readlink "$C/$a/skills")" = "../shared/skills" ] || bad="$bad $a"; done
[ -z "$bad" ] && rec PASS "Claude yoloN/skills เป็นลิงก์ไป shared" "yoloN/skills -> ../shared/skills" || rec FAIL "Claude yoloN/skills เป็นลิงก์ไป shared" "ไม่ใช่ลิงก์:$bad"
bad=""; for a in $CODEX_ACCOUNTS; do { [ -d "$X/$a/skills" ] && [ ! -L "$X/$a/skills" ]; } || bad="$bad $a"; done
[ -z "$bad" ] && rec PASS "Codex cyoloN/skills เป็นโฟลเดอร์จริง (ลิงก์รายตัว)" "Codex เขียน skills/.system เองได้" || rec FAIL "Codex cyoloN/skills เป็นโฟลเดอร์จริง (ลิงก์รายตัว)" "$bad"
for t in claude codex; do
    f="$BASE_PATH/.${t^}/shared/skills/shared-check/SKILL.md"
    if code="$(grep -oE "SHARED_SKILL_OK-$t-[0-9a-f]{8}" "$f" 2>/dev/null | head -n1)" && [ -n "$code" ]; then
        rec PASS "รหัส shared-check ($t) มีในไฟล์" "SHARED_SKILL_OK-$t-…  sha256=$(printf %s "$code" | sha256sum | cut -c1-12)"
    else rec FAIL "รหัส shared-check ($t) มีในไฟล์" "ไม่พบรูปแบบรหัสใน $f"; fi
done

# 5) MCP ส่วนกลาง
for t in Claude Codex; do
    f="$BASE_PATH/.$t/shared/mcp/mcp.json"
    if python3 -c 'import json,sys; assert "playwright" in json.load(open(sys.argv[1]))["mcpServers"]' "$f" 2>/dev/null; then
        rec PASS "$t shared/mcp/mcp.json มี playwright" "$f"
    else rec FAIL "$t shared/mcp/mcp.json มี playwright" "อ่านไม่ได้หรือไม่มี mcpServers.playwright"; fi
done
for a in $CODEX_ACCOUNTS; do
    if l="$($a mcp list 2>&1)" && grep -q '^playwright\b' <<<"$l"; then rec PASS "$a mcp list เห็น playwright" "$(grep '^playwright' <<<"$l" | tr -s ' ' | cut -c1-90)"
    else rec FAIL "$a mcp list เห็น playwright" "$(head -c 150 <<<"$l")"; fi
done
bad=""; for a in $CLAUDE_ACCOUNTS; do AI_ACCOUNTS_DRY_RUN=1 $a 2>&1 | grep -q -- "--mcp-config=$C/shared/mcp/mcp.json" || bad="$bad $a"; done
[ -z "$bad" ] && rec PASS "yoloN ส่ง --mcp-config=<shared mcp.json>" "dry-run ทั้ง 5 บัญชี (claude mcp list ไม่แสดง MCP นี้ ต้องดูด้วย /mcp)" || rec FAIL "yoloN ส่ง --mcp-config=<shared mcp.json>" "$bad"

# 6) ไม่มี credential ใน shared / ไม่ symlink .claude.json / Codex ใช้ file store
leak="$(find "$C/shared" "$X/shared" \( -name '.credentials.json' -o -name 'auth.json' -o -name '.claude.json' -o -name '*.token' \) 2>/dev/null)"
[ -z "$leak" ] && rec PASS "ไม่มีไฟล์ credential ใน shared" "find .credentials.json/auth.json/.claude.json ใน shared = 0" || rec FAIL "ไม่มีไฟล์ credential ใน shared" "$leak"
bad=""; for a in $CLAUDE_ACCOUNTS; do [ -L "$C/$a/.claude.json" ] && bad="$bad $a"; done
[ -z "$bad" ] && rec PASS ".claude.json ไม่เป็น symlink" "แต่ละ yoloN มีสถานะล็อกอินของตัวเอง" || rec FAIL ".claude.json ไม่เป็น symlink" "$bad"
bad=""; for a in $CODEX_ACCOUNTS; do grep -q '^cli_auth_credentials_store *= *"file"' "$X/$a/config.toml" 2>/dev/null || bad="$bad $a"; done
AI_ACCOUNTS_DRY_RUN=1 cyolo1 2>&1 | grep -q 'cli_auth_credentials_store' && w=yes || w=no
[ -z "$bad" ] && [ $w = yes ] && rec PASS "Codex credential แบบไฟล์ต่อ CODEX_HOME" "config.toml + wrapper -c cli_auth_credentials_store=\"file\"" || rec FAIL "Codex credential แบบไฟล์ต่อ CODEX_HOME" "config.toml ขาด:${bad:- -} wrapper:$w"

# 7) installer รอบ 2 ไม่ทำลายของเดิม
snap() { find "$BASE_PATH" -path "$PLAYWRIGHT_OUTPUT_DIR" -prune -o \( -type f -o -type l \) -print0 2>/dev/null | sort -z | xargs -0 -r sh -c 'for f; do if [ -L "$f" ]; then echo "L $f $(readlink "$f")"; else echo "F $f $(sha256sum < "$f" | cut -c1-16)"; fi; done' _ | sha256sum | cut -c1-16; }
s1="$(snap)"; il="$(ai-accounts-init 2>&1 | tail -n1)"; s2="$(snap)"
[ "$s1" = "$s2" ] && rec PASS "ai-accounts-init รอบซ้ำไม่เขียนทับ" "snapshot ก่อน=หลัง ($s1); ${il#\[ai-accounts-init\] }" || rec FAIL "ai-accounts-init รอบซ้ำไม่เขียนทับ" "snapshot เปลี่ยน $s1 → $s2"

# 8) wrapper แจ้งชัดเมื่อไม่มีโฟลเดอร์บัญชี / ไม่แตะ .bashrc
m="$(AI_ACCOUNTS_BASE=/nonexistent-ai-accounts yolo1 --version 2>&1)"; rc=$?
[ $rc = 2 ] && grep -q "ไม่พบโฟลเดอร์บัญชี" <<<"$m" && rec PASS "wrapper แจ้งเมื่อไม่มีโฟลเดอร์บัญชี" "exit 2: $(head -n1 <<<"$m")" || rec FAIL "wrapper แจ้งเมื่อไม่มีโฟลเดอร์บัญชี" "exit $rc"
if grep -qE 'ai-accounts|yolo|CLAUDE_CONFIG_DIR|CODEX_HOME' "$HOME/.bashrc" 2>/dev/null; then rec FAIL ".bashrc ไม่ถูกแก้" "พบค่าที่เกี่ยวกับ ai-accounts ใน ~/.bashrc"
else rec PASS ".bashrc ไม่ถูกแก้" "wrapper อยู่ใน /usr/local/bin (PATH ของ image)"; fi

# 9) Git / SSH / Chromium
g="$(git --version 2>&1)"; rec "$(ok git --version && echo PASS || echo FAIL)" "Git ปกติ" "$g"
if pgrep -x sshd >/dev/null && ok sshd -t; then rec PASS "SSH (sshd) ปกติ" "sshd ทำงาน, sshd -t ผ่าน"; else rec FAIL "SSH (sshd) ปกติ" "sshd ไม่ทำงานหรือ config ผิด"; fi
PWDIR="$(npm root -g)/@playwright/mcp"
pwv="$(cd "$PWDIR" 2>/dev/null && node -e 'const p=require("path"),d=p.dirname(require.resolve("playwright-core"));console.log(require(p.join(d,"package.json")).version)' 2>/dev/null)"
want="$(cd "$PWDIR" 2>/dev/null && node -e 'const p=require("path"),b=require(p.join(p.dirname(require.resolve("playwright-core")),"browsers.json"));const c=b.browsers.find(x=>x.name==="chromium");console.log(c.revision)' 2>/dev/null)"
have="$(ls -d "$PLAYWRIGHT_BROWSERS_PATH"/chromium-* 2>/dev/null | sed 's/.*chromium-//' | tr '\n' ' ')"
if [ -n "$want" ] && [ -d "$PLAYWRIGHT_BROWSERS_PATH/chromium-$want" ]; then rec PASS "Chromium ตรงกับ playwright ใน @playwright/mcp" "playwright-core $pwv ต้องการ chromium-$want, มี: $have($PLAYWRIGHT_BROWSERS_PATH)"
else rec FAIL "Chromium ตรงกับ playwright ใน @playwright/mcp" "ต้องการ chromium-${want:-?} มี: ${have:-none}"; fi

# 10) Playwright MCP ผ่าน stdio จริง (ไม่ผ่าน AI)
if [ $NO_BROWSER = 1 ]; then
    rec SKIP "Playwright MCP stdio" "--no-browser"
else
    for t in Claude Codex; do
        shot="ai-accounts-check-${t,,}.png"
        j="$(python3 /usr/local/lib/ai-accounts/mcp_stdio_probe.py --config "$BASE_PATH/.$t/shared/mcp/mcp.json" --url "$URL" --screenshot "$shot" 2>&1 | tail -n1)"
        f="$(python3 - "$j" <<'PY'
import json, sys
try: j = json.loads(sys.argv[1])
except Exception: print("ERR|probe output ไม่ใช่ JSON|-|-"); sys.exit()
i = j.get("initialize", {}); t = j.get("tools_list", {}); n = j.get("browser_navigate", {}); s = j.get("browser_take_screenshot", {})
si = i.get("serverInfo") or {}
print("|".join([
  "OK" if i.get("ok") else "ERR " + j.get("error", "")[:120],
  f"{si.get('name','?')} {si.get('version','')} protocol {i.get('protocolVersion','?')}" if i.get("ok") else "-",
  f"{t.get('count',0)} tools, มี {','.join(t.get('has',[]))}" if t.get("ok") else ("ERR" if t else "-"),
  (f"title=\"{n.get('title','')}\"" if n.get("ok") else "ERR " + (n.get("excerpt") or j.get("error",""))[:150]) if n or j.get("error") else "-",
  s.get("reported", "") if s.get("ok") else "",
]))
PY
)"
        IFS='|' read -r st init tl nav sh <<<"$f"
        [ "$st" = OK ] && rec PASS "$t MCP stdio: initialize" "$init" || rec FAIL "$t MCP stdio: initialize" "$st"
        [[ "$tl" == ERR* || "$tl" == "-" ]] && rec FAIL "$t MCP stdio: tools/list" "$tl" || rec PASS "$t MCP stdio: tools/list" "$tl"
        if [[ "$nav" == ERR* || "$nav" == "-" ]]; then rec FAIL "$t MCP stdio: browser_navigate" "$URL → $nav"
        else rec PASS "$t MCP stdio: browser_navigate" "$URL → $nav${sh:+; screenshot $sh}"; fi
    done
fi

# 11) สิ่งที่ต้องล็อกอิน
rec SKIP "ล็อกอิน yoloN / cyoloN" "ต้องให้ผู้ใช้ล็อกอินเอง (ห้ามล็อกอินแทน)"
rec SKIP "เรียก skill shared-check ผ่าน AI" "ต้องล็อกอิน — ใช้ verify-prompt.txt หลังล็อกอิน"
rec SKIP "Claude /mcp เห็น playwright, AI เรียก tool playwright" "ต้องล็อกอิน"

# ---- ตาราง ---------------------------------------------------------------------
w=0; for r in "${ROWS[@]}"; do IFS='|' read -r s i e <<<"$r"; l=$(printf %s "$i" | wc -m); [ $l -gt $w ] && w=$l; done
printf '\n%-4s  %s  %s\n' "ผล" "$(printf '%-*s' $w 'รายการ')" "หลักฐาน"
for r in "${ROWS[@]}"; do
    IFS='|' read -r s i e <<<"$r"
    pad=$((w - $(printf %s "$i" | wc -m)))
    printf '%-4s  %s%*s  %s\n' "$s" "$i" $pad "" "$e"
done
printf '\nสรุป: PASS=%d FAIL=%d SKIP=%d\n' $NP $NF $NS
[ $NF = 0 ]
