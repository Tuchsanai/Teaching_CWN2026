# LAB 004 deployment settings. Copy to deploy/lab04.env and edit if needed.
# deploy/lab04.env is git/docker-ignored. It holds NO secrets.

# The script refuses to run unless `docker info --format '{{.Name}}'` prints this.
# Outer Docker Desktop daemon = docker-desktop. The daemon you see *inside* devtools
# (e.g. 567edcb8c206) is the INNER one and must not be used for this lab.
EXPECTED_DOCKER_NAME=docker-desktop

# devtools container on the outer daemon, and where its account folders live (LAB 001).
DEVTOOLS_CONTAINER=devtools
SRC_CLAUDE_BASE=/root/ai-accounts/.Claude
SRC_CODEX_BASE=/root/ai-accounts/.Codex

# Accounts exposed by the API (comma separated, first = default). Default: one per provider.
CLAUDE_ACCOUNTS=yolo1
CODEX_ACCOUNTS=cyolo1
# 1 = also copy yolo*/.claude.json (account metadata + project history, no tokens).
# Leave 0 unless an authenticated test proves Claude needs it.
CLAUDE_COPY_CLAUDE_JSON=0

# Images, containers, volume, network (all created on the outer daemon).
API_IMAGE=lab04-api:0.4.0
WEB_IMAGE=lab04-web:0.4.0
API_CONTAINER=lab04-api
WEB_CONTAINER=lab04-web
ACCOUNTS_VOLUME=lab04-accounts
NETWORK=lab04-net

# Published on the Docker Desktop host loopback only (8004/8005 if free: `check` verifies).
BIND_ADDR=127.0.0.1
API_PORT=8004
WEB_PORT=8005

# Where THIS control host's curl reaches those published ports. The class control host
# (SSH port 22022) is itself a container, so its own 127.0.0.1 is NOT the Docker Desktop
# host: use host.docker.internal there. Use 127.0.0.1 only when running on the host itself.
PROBE_HOST=host.docker.internal
# Host name printed for the browser on the Windows host (the browser still uses localhost).
BROWSER_HOST=localhost

# API limits (see api/app/config.py for ranges).
CLI_TIMEOUT_S=300
PER_ACCOUNT_CONCURRENCY=1
MAX_CONCURRENCY=4
CODEX_SANDBOX=read-only
