# Copy to .env (scripts/deploy.sh does this; it fills APP_PORT, APP_URL, APP_TEST_URL and accounts).
# No secrets in this file. Never commit .env.

# --- Target Docker host: the OUTER host where devtools itself runs (sibling container).
# devtools' own `docker` reaches only its inner daemon, so this must be set explicitly, e.g.
#   ssh://USER@HOST:PORT  (used through scripts/ssh-shim with the ControlMaster below)
# deploy.sh refuses to deploy if this points at devtools' inner daemon.
DOCKER_HOST=
# Already-open SSH ControlMaster socket and the known_hosts file to use with it
SSH_CONTROL_PATH=
SSH_KNOWN_HOSTS=
# Folder on the control host (reached over SSH) that holds the complete source copy.
# Note: the Docker daemon may NOT see this filesystem, so nothing is bind-mounted from it.
REMOTE_SOURCE_DIR=
# Named volume holding index.html (filled from devtools through a pipe, mounted read-only)
WEB_VOLUME=ai-chat-web

# --- Filled in by deploy.sh after checking the network for real
# URL for your own browser on the Docker host machine
APP_URL=
# URL that devtools / Playwright can actually reach
APP_TEST_URL=

COMPOSE_PROJECT_NAME=ai-chat
APP_IMAGE=ai-chat-app:latest
APP_CONTAINER_NAME=ai-chat-app
ACCOUNTS_VOLUME=ai-chat-accounts

# Host port published for the app (the container always listens on 0.0.0.0:8004). The API and
# the page URL use this same value.
# deploy.sh checks it on the Docker host and replaces it with a free port if 8004 is taken.
APP_PORT=8004
# Interface on the Docker host to publish on (127.0.0.1 = local only; 0.0.0.0 = all interfaces).
APP_BIND=127.0.0.1

# Bearer token for /v1/* lives in this owner-only (0600) file, not in .env. deploy.sh creates it
# with a random value if missing and never prints it. Read it yourself with: cat secrets/api_token
API_TOKEN_FILE=secrets/api_token

# Accounts enabled in the app. deploy.sh rewrites these with the accounts that have
# login data in devtools. yoloN = Claude only, cyoloN = Codex only.
CLAUDE_ACCOUNTS=yolo1
CODEX_ACCOUNTS=cyolo1
DEFAULT_CLAUDE_ACCOUNT=yolo1
DEFAULT_CODEX_ACCOUNT=cyolo1
# Where deploy.sh reads the source accounts in devtools (read only, never modified).
SOURCE_ACCOUNTS_BASE=/root/ai-accounts

DEFAULT_MODEL=fable
DEFAULT_REASONING_EFFORT=medium

# Request limits
MAX_BODY_BYTES=262144
MAX_MESSAGES=100
MAX_MESSAGE_CHARS=32000
MAX_TOTAL_CHARS=120000

# Per CLI call limits
CLI_TIMEOUT_SECONDS=240
CLI_MAX_OUTPUT_BYTES=4194304
MAX_CONCURRENT_CALLS=2
QUEUE_TIMEOUT_SECONDS=30

# Container limits
APP_MEM_LIMIT=2g
APP_CPUS=2
