#!/usr/bin/env python3
"""Stand-in for `claude` used only by the unit tests. Behaviour is chosen by
markers inside the prompt (the runner strips the environment)."""
import json, os, sys, time

if sys.argv[1:] == ["--version"]:
    print("9.9.9 (Fake Claude Code)"); sys.exit(0)
prompt = sys.stdin.read()
if "FAKE_SLEEP" in prompt:
    time.sleep(5)
if "FAKE_AUTH_FAIL" in prompt:
    print(json.dumps({"type": "result", "subtype": "success", "is_error": True,
                      "result": "Not logged in · Please run /login SECRET-ish-detail"}))
    sys.exit(1)
if "FAKE_BIG" in prompt:
    text = "x" * 30000
else:
    text = json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd(),
                       "env_keys": sorted(os.environ), "prompt_tail": prompt[-400:],
                        "env": {k: os.environ.get(k) for k in ("HOME", "TMPDIR", "CLAUDE_CONFIG_DIR", "CODEX_HOME")}})
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": text}))
