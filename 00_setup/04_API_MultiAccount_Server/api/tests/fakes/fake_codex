#!/usr/bin/env python3
"""Stand-in for `codex` used only by the unit tests."""
import json, os, sys

args = sys.argv[1:]
if args == ["--version"]:
    print("codex-cli 9.9.9"); sys.exit(0)
prompt = sys.stdin.read() if args and args[-1] == "-" else ""
print("user\n" + prompt, file=sys.stderr)  # real Codex echoes the prompt on stderr too
if "FAKE_AUTH_FAIL" in prompt:
    print("ERROR: unexpected status 401 Unauthorized", file=sys.stderr); sys.exit(1)
if "FAKE_RATE" in prompt:
    print("ERROR: You've hit your usage limit.", file=sys.stderr); sys.exit(1)
out = args[args.index("-o") + 1]
with open(out, "w") as f:
    f.write(json.dumps({"argv": args, "cwd": os.getcwd(), "env_keys": sorted(os.environ),
                        "prompt_tail": prompt[-400:],
                        "env": {k: os.environ.get(k) for k in ("HOME", "TMPDIR", "CLAUDE_CONFIG_DIR", "CODEX_HOME")}}))
