# ============================================================
# .env_example — ตัวอย่างไฟล์ .env ของ container multi-account-devtool
# วิธีใช้: cp .env_example .env แล้วใส่ค่าจริงของตัวเอง
# ห้าม commit ไฟล์ .env (ถูก ignore ไว้แล้วใน .gitignore)
# ห้ามใส่เครื่องหมายคำพูด "..." ครอบค่า (docker --env-file เก็บ " ไว้เป็นส่วนหนึ่งของค่า)
# ============================================================

# ---- local skill → shared ของ Claude และ Codex ----
# path บนเครื่อง host ของโฟลเดอร์ที่เก็บ skill (แต่ละ skill = โฟลเดอร์ย่อยที่มี SKILL.md)
# หรือชี้ไปที่โฟลเดอร์ skill เดียวที่มี SKILL.md อยู่ตรงตัวก็ได้
# path แบบ relative นับจากโฟลเดอร์ของไฟล์ .env นี้ · เว้นว่าง = ไม่โหลด local skill
# ตัวอย่าง: LOCAL_SKILLS_DIR=C:/Users/<ชื่อผู้ใช้>/my-skills
#          LOCAL_SKILLS_DIR=../04_Skill_Setup/my-skills
LOCAL_SKILLS_DIR=
