#!/bin/bash
# ai-accounts-setup — installer ระบบหลายบัญชี Claude Code (yolo1..5) + Codex CLI (cyolo1..5)
# ทำตาม prompt_multi_account.md; start.sh เรียกทุกครั้งที่ container start
# รันซ้ำได้: สร้างเฉพาะสิ่งที่ยังไม่มี ไม่เขียนทับ credential/config/skill/mcp.json/ค่าสุ่มเดิม
# ไม่แก้ .bashrc / Git / SSH ไม่เปลี่ยน $HOME ไม่พิมพ์ secret
set -u
. /etc/ai-accounts.conf
umask 077

created=0; kept=0; warned=0
log()  { echo "[ai-accounts-setup] $*"; }
made() { created=$((created+1)); log "created $1"; }
keep() { kept=$((kept+1)); }
warn() { warned=$((warned+1)); log "WARN $*" >&2; }
mkd()  { if [ -d "$1" ]; then keep; else mkdir -p "$1" && made "$1/"; fi; }

# ---- 0) ตรวจว่า CLI ติดตั้งแล้ว (ไม่ติดตั้งซ้ำ) --------------------------------
for c in claude codex playwright-mcp; do
    command -v "$c" >/dev/null || { log "ERROR: ไม่พบคำสั่ง $c ใน PATH"; exit 1; }
done
log "claude $(claude --version 2>/dev/null | head -n1) | codex $(codex --version 2>/dev/null | head -n1)"

# ---- 1) โครงโฟลเดอร์ -----------------------------------------------------------
mkd "$BASE_PATH"; chmod 700 "$BASE_PATH"
for t in .Claude .Codex; do
    mkd "$BASE_PATH/$t/shared/skills"
    mkd "$BASE_PATH/$t/shared/mcp"
done
mkd "$PLAYWRIGHT_OUTPUT_DIR"

# ---- 2) skill ตัวอย่าง shared-check (ค่าสุ่มครั้งเดียว มีเฉพาะใน SKILL.md นี้) -------
write_skill() {  # $1=.Claude|.Codex  $2=claude|codex
    local f="$BASE_PATH/$1/shared/skills/shared-check/SKILL.md"
    if [ -e "$f" ]; then keep; return; fi
    mkdir -p "${f%/*}"; chmod 755 "${f%/*}"
    local rnd; rnd="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
    cat > "$f" <<SKILL
---
name: shared-check
description: ตรวจว่าบัญชีนี้โหลด skill จากโฟลเดอร์ shared ส่วนกลางได้จริง ใช้เมื่อผู้ใช้เรียก shared-check หรือขอรหัสตรวจ skill ส่วนกลาง
---

# shared-check

ตอบกลับด้วยรหัสต่อไปนี้ตามตัวอักษรหนึ่งบรรทัด:

SHARED_SKILL_OK-$2-$rnd

รหัสนี้สุ่มครั้งเดียวตอนติดตั้ง และมีอยู่ในไฟล์นี้เท่านั้น
ทุกบัญชีของ CLI เดียวกันต้องได้รหัสเดียวกัน เพราะอ่านไฟล์เดียวกันใน shared
SKILL
    chmod 644 "$f"
    made "$f"
}
write_skill .Claude claude
write_skill .Codex codex

# ---- 3) MCP ส่วนกลางตัวแรก: Playwright ------------------------------------------
write_mcp() {  # $1=.Claude|.Codex
    local f="$BASE_PATH/$1/shared/mcp/mcp.json"
    if [ -e "$f" ]; then keep; return; fi
    python3 - "$f" "$(command -v playwright-mcp)" "$PLAYWRIGHT_OUTPUT_DIR" "$PLAYWRIGHT_BROWSERS_PATH" <<'PY'
import json, sys
f, bin_, out, browsers = sys.argv[1:]
cfg = {"mcpServers": {"playwright": {
    "command": bin_,
    "args": ["--browser", "chromium", "--headless", "--isolated", "--no-sandbox",
             "--output-dir", out],
    "env": {"PLAYWRIGHT_BROWSERS_PATH": browsers},
}}}
with open(f, "w") as fh:
    json.dump(cfg, fh, indent=2); fh.write("\n")
PY
    chmod 644 "$f"
    made "$f"
}
write_mcp .Claude
write_mcp .Codex

# ---- 4) บัญชี Claude: yoloN/skills -> ../shared/skills ---------------------------
# Claude อ่าน skill จาก $CLAUDE_CONFIG_DIR/skills; MCP ส่งตอนเปิดด้วย --mcp-config= (ใน wrapper)
# ไม่ symlink .claude.json (มีสถานะล็อกอินของแต่ละบัญชี)
for a in $CLAUDE_ACCOUNTS; do
    d="$BASE_PATH/.Claude/$a"
    mkd "$d"; chmod 700 "$d"
    if [ -L "$d/skills" ]; then keep
    elif [ -e "$d/skills" ]; then warn "$d/skills เป็นโฟลเดอร์จริง (ไม่ใช่ลิงก์ไป shared) — ไม่แก้ของเดิม"
    else ln -s ../shared/skills "$d/skills" && made "$d/skills -> ../shared/skills"
    fi
done

# ---- 5) บัญชี Codex: mkdir CODEX_HOME, credential แบบไฟล์, skill เชื่อมรายตัว ------
# Codex เขียน $CODEX_HOME/skills/.system เอง → skills ต้องเป็นโฟลเดอร์จริง; wrapper sync ลิงก์ที่ขาดทุกครั้งที่เปิด
for a in $CODEX_ACCOUNTS; do
    d="$BASE_PATH/.Codex/$a"
    mkd "$d"; chmod 700 "$d"
    mkd "$d/skills"
    if [ -e "$d/config.toml" ]; then keep
    else
        printf '# สร้างโดย ai-accounts-setup — แก้ได้ ไม่ถูกเขียนทับ\n# เก็บ credential เป็นไฟล์ $CODEX_HOME/auth.json ของบัญชีนี้ (ไม่ใช้ keyring ของ OS)\ncli_auth_credentials_store = "file"\n' > "$d/config.toml"
        made "$d/config.toml"
    fi
    for s in "$BASE_PATH"/.Codex/shared/skills/*/; do
        [ -d "$s" ] || continue
        s="${s%/}"; l="$d/skills/${s##*/}"
        if [ -e "$l" ] || [ -L "$l" ]; then keep; else ln -s "../../shared/skills/${s##*/}" "$l" && made "$l"; fi
    done
done

# ---- 6) wrapper ใน /usr/local/bin (อยู่ใน PATH แล้ว ไม่ต้องแก้ .bashrc) ------------
for a in $CLAUDE_ACCOUNTS $CODEX_ACCOUNTS; do
    w="/usr/local/bin/$a"
    if [ -L "$w" ] || [ -e "$w" ]; then keep
    elif [ -w /usr/local/bin ]; then ln -s ai-account "$w" && made "$w -> ai-account"
    else warn "เขียน /usr/local/bin ไม่ได้ — สร้าง wrapper $a ไม่ได้"
    fi
done

log "done: base=$BASE_PATH created=$created kept=$kept warnings=$warned"
