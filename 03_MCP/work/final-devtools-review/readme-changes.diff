+curl -s -X POST http://127.0.0.1:8765/api/tts -H "Content-Type: application/json" \
+     -d '{"text":"Setup test from prompt.","voice":"af_heart"}'                  # ครั้งแรก ~3 วินาที (โหลดโมเดล) ครั้งต่อไปต่ำกว่า 1 วินาที
