+
+```bash
+# รันจากโฟลเดอร์บทเรียน 03_MCP ที่มี labs/ อยู่แล้ว
+PYTHON="$(pwd)/labs/.venv/bin/python" labs/kokoro-web/run.sh                     # เปิด http://127.0.0.1:8765 (pid ใน labs/kokoro-web/server.pid)
