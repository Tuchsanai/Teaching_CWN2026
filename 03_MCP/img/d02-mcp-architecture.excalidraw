      "index": "a18",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "สิ่งที่ server ประกาศให้ client\n• Tools = ฟังก์ชันให้โมเดลเรียก (tools/list, tools/call)\n• Resources = ข้อมูลให้อ่าน (resources/read)\n• Prompts = แม่แบบข้อความ (prompts/get)",
      "roughness": 1,
      "roundness": null,
      "seed": 583594700,
      "strokeColor": "#9c36b5",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "สิ่งที่ server ประกาศให้ client\n• Tools = ฟังก์ชันให้โมเดลเรียก (tools/list, tools/call)\n• Resources = ข้อมูลให้อ่าน (resources/read)\n• Prompts = แม่แบบข้อความ (prompts/get)",
      "textAlign": "center",
      "updated": 1789799230321,
      "version": 1,
      "versionNonce": 2044640854,
      "verticalAlign": "middle"
    },
