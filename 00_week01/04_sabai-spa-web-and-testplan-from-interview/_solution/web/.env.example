# ไม่มีไฟล์ .env ก็รันได้ · ค่าด้านล่างคือค่า default ใน docker-compose.yml
DATABASE_URL=postgres://sabai:sabai@sabai-db:5432/sabai
# 1 = เปิดโหมดทดสอบ (ปุ่มรีเซ็ต ล็อกเวลา) · 0 = ปิด: API ทดสอบตอบ 404 ปุ่มหาย นาฬิกาใช้เวลาจริง
ALLOW_TEST_RESET=1
BUG_MODE=0
SESSION_SECRET=sabai-local-dev-session-secret-change-me
# ภาพจำลองก่อน/หลัง FR-76 · compose นี้เปิดโหมดทดสอบ จึง default 1 (D-26)
FEATURE_SKIN_PREVIEW=1
