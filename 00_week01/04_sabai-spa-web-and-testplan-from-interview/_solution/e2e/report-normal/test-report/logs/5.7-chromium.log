d%2Fshop%2Fowner-herbs.jpg&amp;w=512&amp;q=75 512w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=1280&amp;q=75 1280w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=1600&amp;q=75 1600w, /_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=1920&amp;q=75 1920w\" src=\"/_next/image?url=%2Fbrand%2Fshop%2Fowner-herbs.jpg&amp;w=1920&amp;q=75\"/></div></div></div><div class=\"_06co2W_storyText\"><div><p class=\"eyebrow\">เรื่องราวของเรา</p><h2 class=\"_06co2W_headTitle\"><span class=\"_06co2W_noBreakPart\">ร้านสาขาเดียว<!-- --> </span><span class=\"_06co2W_noBreakPart\">ที่ตั้งใจให้คุณสบายใจ<!-- --> </span></h2><span aria-hidden=\"true\" class=\"_06co2W_ornament\"></span></div><figure class=\"_06co2W_storyQuoteBox\"><blockquote class=\"_06co2W_storyQuote\"><span class=\"_06co2W_noBreakPart\">อยากให้เว็บดูไทย<!-- --> </span><span class=\"_06co2W_noBreakPart\">หรู<!-- --> </span><span class=\"_06co2W_noBreakPart\">และรู้สึกว่า<!-- --> </span><span class=\"_06co2W_noBreakPart\">“มาร้านจริง”<!-- --> </span></blockquote><figcaption class=\"_06co2W_storySign\">คุณจันทร์<!-- --> · <!-- -->เจ้าของร้าน</figcaption></figure><div class=\"_06co2W_storyBody\"><p>สบายใจ สปาเป็นร้านสาขาเดียวในกรุงเทพฯ ของคุณจันทร์ เปิดทุกวันรวมวันหยุดนักขัตฤกษ์ รับลูกค้าเป็นรอบทุก 30 นาที และนักบำบัด 1 คนดูแลทีละคิว ไม่จองเวลาทับกัน</p><p>คุณจันทร์จึงให้เว็บนี้ใช้รูปร้านและรูปทีมงานของเราเอง บอกชัดว่าแต่ละบริการใช้สมุนไพรอะไร ให้ดูห้องแบบ 360° ก่อนมา และมีเพลงสปาเบา ๆ ที่คุณกดเปิดเองเมื่ออยากฟัง</p><p>ความเป็นส่วนตัวก็สำคัญไม่แพ้กัน ร้านไม่เก็บรูปหน้าลูกค้า และเซลฟี่ที่ใช้วิเคราะห์ผิวอยู่ในเครื่องของคุณเท่านั้น</p></div><div class=\"_06co2W_buttonRow\"><a data-testid=\"home-story-about\" class=\"Hi2WXW_btn Hi2WXW_btn-primary Hi2WXW_btn-md\" href=\"/th/a