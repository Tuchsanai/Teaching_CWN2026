# ตัวอย่างค่าเท่านั้น: copy เป็น .env แล้วเปลี่ยนค่าจริง (.env ห้าม commit)
# คอมเมนต์ต้องอยู่บรรทัดแยก ห้ามต่อท้ายค่า
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# ฐานข้อมูลและคิว
DATABASE_URL=postgresql://app:app@localhost:5432/member_pay?schema=public
REDIS_URL=redis://localhost:6379

# JWT: secret ยาวอย่างน้อย 32 ตัวอักษร
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
# อายุ access token (วินาที) ตามกติกาข้อ 9 = 900 (15 นาที)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ThaiPay GW
THAIPAY_MERCHANT_ID=merchant-demo-001
THAIPAY_WEBHOOK_SECRET=change-me-webhook-secret
THAIPAY_GATEWAY_URL=https://sandbox.thaipay.example/checkout

# LINE Messaging API
LINE_CHANNEL_TOKEN=change-me-line-token
