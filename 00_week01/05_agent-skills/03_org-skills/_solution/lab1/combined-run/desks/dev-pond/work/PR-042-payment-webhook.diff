+"use client";
+export function DepositButton({ appointmentId }: { appointmentId: string }) {
+  async function goToGateway() {
+    const res = await fetch(`/api/payment/deposit`, {
+      method: "POST",
+      body: JSON.stringify({ appointmentId }),
+    });
+    const { data } = await res.json();
+    window.location.href = data.gatewayUrl; // ไป ThaiPay GW เลย
+  }
+  return <button onClick={goToGateway}>จ่ายมัดจำ</button>;
+}

