diff --git a/src/app/api/payment/webhook/route.ts b/src/app/api/payment/webhook/route.ts
new file mode 100644
--- /dev/null
+++ b/src/app/api/payment/webhook/route.ts
@@ -0,0 +1,24 @@
+import { NextResponse } from "next/server";
+import { handleWebhook, verifySignature } from "@/modules/payment";
+import { logger } from "@/lib/logger";
+
+export async function POST(req: Request) {
+  const raw = await req.text();
+  const sig = req.headers.get("x-thaipay-signature") ?? "";
+  if (!verifySignature(raw, sig)) {
+    return NextResponse.json({ ok: false, reason: "bad signature" }, { status: 401 });
+  }
+  try {
+    await handleWebhook(JSON.parse(raw));
+    return NextResponse.json({ ok: true });
+  } catch (err) {
+    logger.error({ module: "payment", err }, "webhook failed");
+    return NextResponse.json({ ok: false, reason: String(err), stack: (err as Error).stack }, { status: 500 });
+  }
+}

