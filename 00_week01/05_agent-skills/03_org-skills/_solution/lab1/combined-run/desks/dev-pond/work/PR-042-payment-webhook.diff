diff --git a/src/modules/payment/service.ts b/src/modules/payment/service.ts
--- a/src/modules/payment/service.ts
+++ b/src/modules/payment/service.ts
@@ -1,40 +1,78 @@
 import { logger } from "@/lib/logger";
 import { paymentRepository } from "./repository";
+import { createHmac } from "node:crypto";
+import { WebhookPayloadSchema, type WebhookPayload } from "./schema";
+
+const WEBHOOK_SECRET = process.env.THAIPAY_WEBHOOK_SECRET || "dev-secret-123";
+
+export async function createDepositOrder(appointmentId: string, amount: number) {
+  const order = await paymentRepository.insertOrder({ appointmentId, amount, status: "pending" });
+  logger.info({ module: "payment", orderId: order.id }, "deposit order created");
+  return order;
+}
+
+export function verifySignature(rawBody: string, signature: string): boolean {
+  const expected = createHmac("sha256", WEBHOOK_SECRET).update(rawBody).digest("hex");
+  return expected === signature;
+}
+
+export async function handleWebhook(input: unknown) {
+  const payload: WebhookPayload = WebhookPayloadSchema.parse(input);
+
+  const seen = await paymentRepository.findEvent(payload.eventId);
+  if (seen) return;
+
+  const order = await paymentRepository.findOrder(payload.orderId);
+  if (!order) throw new Error("order not found");
+
+  try {
+    await paymentRepository.updateOrderStatus(order.id, payload.status);
+    await paymentRepository.insertEvent(payload.eventId, payload);
+  } catch (e) {
+    // ignore, gateway จะส่งมาใหม่เอง
+  }
+}

