+  ["couple-S02-U01-H04", "U01", { type: "couple", serviceCode: "S02", people: 2, date: D, time: "14:00", hotelCode: "H04" }],
+  ["single-S01-U08-H05", "U08", S({ hotelCode: "H05" })],
