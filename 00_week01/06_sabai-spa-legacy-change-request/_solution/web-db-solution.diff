+  test('KI-02b [ควรเป็น] เบอร์ "abc" ถูกปฏิเสธ (4xx) ไม่สร้างนัด', async ({ request }) => {
+    test.info().annotations.push(KI('KI-02'));
+    test.fail(true, 'KI-02 ยังไม่แก้ · ต้องถามร้านรูปแบบเบอร์ที่รับ');
