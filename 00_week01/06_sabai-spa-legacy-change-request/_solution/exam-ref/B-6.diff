+CREATE TABLE IF NOT EXISTS therapist_leave (
+  therapist_id INTEGER NOT NULL REFERENCES therapist(id) ON DELETE CASCADE,
+  leave_date   DATE NOT NULL,
+  PRIMARY KEY (therapist_id, leave_date)
+);
