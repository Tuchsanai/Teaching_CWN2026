+
+/** EX-A7: ประวัติแต้มจาก point_txn · balanceAfter สะสมจากเก่าไปใหม่ แล้วคืนเรียงใหม่ → เก่า */
+export async function pointsHistory(db: Db, uid: number, lang: Lang) {
+  const c = await db.query("SELECT points_balance FROM customer WHERE id = $1", [uid]);
+  if (!c.rows[0]) return null;
+  const r = await db.query(
+    `SELECT p.points, p.reason, p.created_at, b.code AS booking_code
+       FROM point_txn p LEFT JOIN booking b ON b.id = p.booking_id
+      WHERE p.customer_id = $1 ORDER BY p.created_at, p.id`,
+    [uid],
+  );
+  let run = 0;
+  const items = r.rows.map((x) => {
+    run += x.points;
+    return {
+      date: bangkokDate(new Date(x.created_at)),
+      bookingCode: (x.booking_code as string | null) ?? null,
+      points: x.points as number,
+      reason: x.reason as string,
+      reasonLabel: t(lang, `points.reason.${x.reason}`),
+      balanceAfter: run,
+    };
+  });
+  return { balance: c.rows[0].points_balance as number, items: items.reverse() };
+}
