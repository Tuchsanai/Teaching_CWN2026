+++ b/web/app/api/me/points/route.ts
@@ -0,0 +1,17 @@
+import { getPool } from "@/lib/db.ts";
+import { pointsHistory } from "@/lib/server/customer.ts";
+import { ApiError, getLang, handle, json } from "@/lib/server/http.ts";
+import { getSession } from "@/lib/session.ts";
+
+export const dynamic = "force-dynamic";
+
+/** GET /api/me/points — ประวัติแต้ม เรียงใหม่ → เก่า (EX-A7) */
+export async function GET() {
+  return handle(async () => {
+    const s = await getSession();
+    if (!s) throw new ApiError(401, "LOGIN_REQUIRED");
+    const h = await pointsHistory(getPool(), s.uid, await getLang());
+    if (!h) throw new ApiError(401, "LOGIN_REQUIRED");
+    return json(h);
+  });
+}
