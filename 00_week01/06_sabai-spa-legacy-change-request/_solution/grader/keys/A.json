    { "id": 8, "label": "ทัวร์ 360° / ข้อความห้องเดียว", "re": ["Tour360|360"] },
    { "id": 9, "label": "วันมีผลผูกกับวันนัด", "re": ["(1 พ\\.?ย|2026-11-01|11-01|1 Nov)[\\s\\S]{0,300}(วันนัด|วันที่นัด|start_?at|appointment)|(วันนัด|วันที่นัด|start_?at|appointment)[\\s\\S]{0,300}(1 พ\\.?ย|2026-11-01|11-01|1 Nov)"] },
    { "id": 10, "label": "ตาราง/seed ที่ reset ใช้", "re": ["testmode|TRUNCATE|/api/test/reset"] }
