    "A1": { "parts": [{ "w": 0.8, "file": ["web/lib/server/booking\\.ts"], "all": ["completeBooking"], "any": ["point_txn", "earn", "points_balance", "แต้ม"], "min": 1 }] },
    "A2": { "parts": [{ "w": 0.8, "file": ["db/init/01-schema\\.sql"], "any": ["booking_slot_no_overlap", "exclude", "gist"], "min": 1 }] },
    "A3": { "parts": [{ "w": 0.8, "file": ["web/lib/rules/pricing\\.ts"], "all": ["calcPrice"] }] },
    "A4": { "parts": [
      { "w": 0.4, "file": ["web/lib/server/booking\\.ts"], "any": ["roomBusy", "room_id\\s*=\\s*1"], "min": 1 },
      { "w": 0.4, "file": ["web/lib/server/booking\\.ts"], "any": ["createBooking", "roomId\\s*[=:]\\s*1"], "min": 1 }
    ] },
    "A5": { "parts": [{ "w": 0.8, "file": ["web/lib/bot/chat\\.ts"], "any": ["single", "เดี่ยว", "people\\W{0,3}1", "1\\s*คน", "one person"], "min": 1 }] },
    "A6": { "parts": [{ "w": 0.8, "file": ["web/lib/clock\\.ts"], "any": ["test_today", "app_setting"], "min": 1 }] },
    "A7": { "parts": [{ "w": 0.8, "file": ["web/components/PackageCalc\\.tsx"], "all": ["PackageCalc"] }] },
    "A8": { "parts": [{ "w": 0.8, "file": ["web/lib/server/booking\\.ts"], "all": ["cancelBooking"],
      "any": ["slot|inactive|active\\s*=\\s*false|ช่วงเวลา|คิว", "reserved_sessions|คอร์ส|course", "gift|บัตร", "refund|แต้ม|point", "birthday|วันเกิด|เดือนเกิด"], "min": 4 }] },
    "A9": { "parts": [{ "w": 0.8, "file": ["web/lib/server/booking\\.ts", "web/app/api/bookings/route\\.ts"], "all": ["PRICE_CHANGED"] }] },
    "A10": { "parts": [{ "w": 0.8, "file": ["web/lib/i18n\\.ts", "web/lib/bot/chat\\.ts"], "all": ["(^|[^0-9])3([^0-9]|$)|สาม|three"] }] }
  },
  "ex3": [
    { "id": 1, "label": "roomBusy WHERE room_id = 1", "re": ["roomBusy"] },
    { "id": 2, "label": "createBooking roomId = 1", "re": ["createBooking"] },
    { "id": 3, "label": "availableSlots ใช้ roomBusy", "re": ["availableSlots"] },
    { "id": 4, "label": "seed room + migration แถวใหม่บนระบบจริง", "re": ["(migration|INSERT|setval)[\\s\\S]{0,200}\\broom\\b|\\broom\\b[\\s\\S]{0,200}(migration|INSERT|setval)"] },
    { "id": 5, "label": "booking_room_no_overlap (ใช้ต่อห้องได้อยู่แล้ว)", "re": ["booking_room_no_overlap"] },
    { "id": 6, "label": "E20 คู่ที่ 2 รอบ 19:00", "re": ["\\bE20\\b"] },
