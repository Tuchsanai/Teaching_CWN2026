    "B5": { "parts": [{ "w": 0.8, "file": ["web/lib/session\\.ts"], "all": ["HMAC|sha-?256|SESSION_SECRET", "7\\s*(วัน|day)|MAX_AGE|604800"] }] },
    "B6": { "parts": [{ "w": 0.8, "file": ["web/lib/rules/overlap\\.ts", "web/lib/server/booking\\.ts"], "all": ["id\\s*(น้อย|ต่ำ)|lowest|smallest|ascending|sort|ORDER BY"], "any": ["freeTherapists", "ว่าง|free"], "min": 1 }] },
    "B7": { "parts": [{ "w": 0.8, "file": ["db/init/02-seed\\.sql"], "all": ["T01|สมศรี", "T05|ทองใบ"] }] },
    "B8": { "parts": [{ "w": 0.8, "file": ["web/lib/rules/rating\\.ts"], "any": ["ratingTenths", "floor", "ปัด", "round"], "min": 1 }] },
    "B9": { "parts": [{ "w": 0.8, "file": ["web/lib/config\\.ts"], "any": ["reset", "today", "app_setting|นาฬิกา|clock", "login|บัญชีทดสอบ|admin|ปุ่ม"], "min": 3 }] },
    "B10": { "parts": [{ "w": 0.8, "file": ["web/lib/db\\.ts"], "all": ["สตางค์|satang", "toSatang|fromSatang"] }] }
  },
  "ex3": [
