    { "id": 5, "label": "ข้อความเวลาเปิดใน bot/chat.ts", "re": ["chat\\.ts|แชท|chatbot"] },
    { "id": 6, "label": "i18n footer.hours / home.subtitle", "re": ["footer\\.hours|home\\.subtitle"] },
    { "id": 7, "label": "E20 / TC-BOOK-07 (17 ต.ค. = เสาร์)", "re": ["\\bE20\\b|TC-BOOK-07"] },
    { "id": 8, "label": "เวลาทำงานนักบำบัด", "re": ["(นักบำบัด|หมอนวด|therapist)[\\s\\S]{0,200}(เวลาทำงาน|กะ|shift|working|ทำงานถึง)|(เวลาทำงาน|กะ|shift|working)[\\s\\S]{0,200}(นักบำบัด|หมอนวด|therapist)"] },
